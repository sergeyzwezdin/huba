{
    "name": "@sergeyzwezdin/huba",
    "version": "0.0.21",
    "description": "TUI for managing Claude Code tasks - search, view, create, edit, and delete tasks across projects",
    "type": "module",
    "author": "Sergey Zwezdin",
    "license": "MIT",
    "homepage": "https://huba.sh",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sergeyzwezdin/huba.git"
    },
    "scripts": {
        "dev": "bun run index.tsx",
        "dev:watch": "bun run --watch index.tsx",
        "build": "bun run scripts/build.ts",
        "build:darwin-arm64": "bun run scripts/build.ts darwin-arm64",
        "build:darwin-x64": "bun run scripts/build.ts darwin-x64",
        "build:linux-x64": "bun run scripts/build.ts linux-x64",
        "build:linux-arm64": "bun run scripts/build.ts linux-arm64",
        "build:windows-x64": "bun run scripts/build.ts windows-x64",
        "typecheck": "tsc --noEmit",
        "format": "biome check",
        "format:file": "biome check --write --log-level=warn",
        "lint": "biome lint"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/bun": "catalog:",
        "@types/react": "catalog:"
    },
    "peerDependencies": {
        "typescript": "catalog:"
    },
    "dependencies": {
        "@opentui-ui/dialog": "catalog:",
        "@opentui-ui/toast": "catalog:",
        "@opentui/core": "catalog:",
        "@opentui/react": "catalog:",
        "@tanstack/react-query": "catalog:",
        "chokidar": "catalog:",
        "jotai": "catalog:",
        "react": "catalog:",
        "react-router": "catalog:",
        "zod": "catalog:"
    },
    "optionalDependencies": {
        "@opentui/core-darwin-arm64": "catalog:",
        "@opentui/core-darwin-x64": "catalog:",
        "@opentui/core-linux-arm64": "catalog:",
        "@opentui/core-linux-x64": "catalog:"
    },
    "patchedDependencies": {
        "@types/react@19.2.14": "apps/huba-tui/patches/@types%2Freact@19.2.14.patch"
    }
}
